---
import '@styles/global.css'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { SEO } from 'astro-seo';
const pathname = Astro.url.pathname;
interface Props {
	title?: string;
	description?: string;
	bare?: boolean;
}

const {
	title = 'Diane Delallée · Fatalement',
	description = 'Diane Delallée: backend developer in Lausanne, side projects, analog photography and volunteering for live music.',
	bare = false,
} = Astro.props;
const ogImage = new URL('/images/screenshot.png', Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="en">
	<head>
		<script is:inline is:head>
      try {
        var theme = localStorage.getItem('heroui-theme');
        if (theme !== 'dark' && theme !== 'light') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.classList.add(theme);
      } catch (e) {
      }
    </script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.ico" />
		<SEO
      title={title}
      description={description}
      charset="UTF-8"
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: ogImage,
        },
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/png", sizes: "16x16", href: "/favicon/favicon-16*16.png" },
          { rel: "icon", type: "image/png", sizes: "32x32", href: "/favicon/favicon-32*32.png" },
          { rel: "apple-touch-icon", sizes: "180x180", href: "/favicon/favicon-96*96.png" },
          { rel: "manifest", href: "/site.webmanifest" },
          { rel: "sitemap", href: "/sitemap-index.xml" },
        ],
        meta: [
          { name: "twitter:image", content: ogImage },
          { name: "twitter:title", content: title },
          { name: "twitter:description", content: description },
          { name: "msapplication-TileColor", content: "#0c0a09" },
          { name: "theme-color", content: "#ffffc7", media: "(prefers-color-scheme: light)" },
          { name: "theme-color", content: "#231411", media: "(prefers-color-scheme: dark)" },
          { name: "generator", content: Astro.generator },
        ],
      }}
    />
	</head>
	<body class="font-gillsans">
		<Header pathname={pathname} />
		<main class={bare ? 'relative z-2' : 'p-4 md:p-8 relative min-h-1/2 z-2'}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
