---
import { projects } from '@data/projects';
---
<ul class="grid">
  {projects.map((p, i) => (
    <li class="card">
      <div class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="path">~/{p.name}</span>
      </div>
      <div class="body">
        <h3>{p.name}</h3>
        <p>{p.description}</p>
        <p class="meta">
          <span class="lang"><i style={`background:${p.color}`}></i>{p.language}</span>
        </p>
        <p class="links">
          <a href={p.repo} target="_blank" rel="noopener">$ view source ↗</a>
          {p.link && <a href={p.link.href} target="_blank" rel="noopener">{p.link.label} ↗</a>}
        </p>
      </div>
    </li>
  ))}
</ul>
<p class="more"><a href="https://github.com/dianedelallee" target="_blank" rel="noopener">More on GitHub ↗</a></p>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--line);
    background: var(--card);
    box-shadow: 6px 6px 0 var(--line);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .card:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--accent); }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--line);
    background: var(--ink);
    color: var(--bg);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.85rem;
  }
  .dots { display: inline-flex; gap: 0.3rem; }
  .dots i { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--bg); opacity: 0.5; }
  .dots i:first-child { background: var(--accent); opacity: 1; }
  .body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; }
  h3 { margin: 0; font-size: 1.8rem; font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; overflow-wrap: anywhere; }
  .body p { margin: 0.75rem 0 0; }
  .meta { font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 0.9rem; color: var(--muted); }
  .lang i { display: inline-block; width: 0.75rem; height: 0.75rem; margin-right: 0.45rem; border-radius: 50%; border: 1px solid var(--line); }
  .links { margin-top: auto !important; padding-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 0.9rem; }
  a { color: var(--accent); font-weight: 700; text-underline-offset: 3px; }
  a:hover { color: var(--ink); }
  .more { margin: 2rem 0 0; font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; }
</style>
