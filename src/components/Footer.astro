---
const year = new Date().getFullYear();
---
<footer>
  <p>© {year} Diane Delallée · Fatalement</p>
  <p class="links">
    <a href="https://github.com/dianedelallee" target="_blank" rel="noopener">GitHub</a>
    <a href="https://www.instagram.com/fixie_des_alpes/" target="_blank" rel="noopener">Instagram</a>
    <a href="mailto:diane.delallee@gmail.com">Email</a>
  </p>
</footer>
<style>
  footer {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1.5rem clamp(1rem, 4vw, 2.5rem) 2.5rem;
    border-top: 2px solid var(--line);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.9rem;
    color: var(--muted);
  }
  p { margin: 0; }
  .links { display: flex; gap: 1.25rem; }
  a { color: var(--ink); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
</style>
