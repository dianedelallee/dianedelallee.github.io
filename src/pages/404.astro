---
import Layout from '@layouts/Layout.astro';
import { Image } from '@heroui/react';
import * as emoji from 'node-emoji';
---

<Layout>
	<main class="container mx-auto max-w-6xl p-10">
		<div class="flex flex-col gap-8 w-full h-full mt-10">
			<div class="md:text-6xl text-5xl text-center">
				You are lost !
			</div>
			<div class="text-center md:text-2xl text-xl">
                Looks like you are trying to access a page that doesn't exist.
			</div>
			<div class="flex w-full justify-center">
				<Image
					isBlurred
					src="/images/lost.jpg"
					classNames={{ img: 'animate-levitate w-72 md:w-96' }}
					alt="Lost Memoji"
					client:load
				/>
			</div>
			<div class="flex w-full justify-center">
				<a href="/" class="inline-block px-6 py-3 border-2 font-mono uppercase tracking-wider font-bold" style="background:var(--accent);border-color:var(--accent);color:var(--on-accent)">Back home</a>
			</div>
		</div>
	</main>
</Layout>

